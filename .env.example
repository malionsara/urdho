# Copy to .env for local development. These match docker-compose.yml.
DATABASE_URL=postgres://urdho:urdho@localhost:5433/urdho
# Wiped and rebuilt by `pnpm test`. Must be a database whose name ends in _test.
TEST_DATABASE_URL=postgres://urdho:urdho@localhost:5433/urdho_test
# Signs the cookies that tie a guest's phone to a table. Use a different long random value in production.
GUEST_SESSION_SECRET=3d1b6d98bd87003489e3e56f1ac40955fe39461eeba0b063b8af4c352b4c1727
# Local only: the seed gives the demo owner, manager and waiter this password. Leave empty to skip them.
DEMO_STAFF_PASSWORD=demo-urdho-2026
# Photo uploads go to Vercel Blob when this is set; without it they go to web/public/uploads.
BLOB_READ_WRITE_TOKEN=
# Unlocks /api/operator (team tools) on this server. Empty: that part of the API doesn't exist.
# The live site's key is set on Vercel; your copy for --live commands goes in .env.operator.
OPERATOR_TOKEN=
