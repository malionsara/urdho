{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm deploy:build",
  "outputDirectory": "dist",
  "regions": ["fra1"],
  "crons": [
    { "path": "/api/cron/daily-summary", "schedule": "0 7 * * *" },
    { "path": "/api/cron/retention", "schedule": "30 2 * * *" },
    { "path": "/api/cron/close-tables", "schedule": "0 2 * * *" },
    { "path": "/api/cron/health-check", "schedule": "0 9 * * *" }
  ],
  "redirects": [
    {
      "source": "/:path((?!sw\\.js$|sw-old-address\\.js$|workbox-[^/]+\\.js$|api/cron/).*)",
      "has": [{ "type": "host", "value": "urdho.vercel.app" }],
      "destination": "https://urdho.al/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api/|api$|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(sw.js|registerSW.js|staff.webmanifest)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
